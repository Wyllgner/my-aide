# Copie para .env e preencha. O .env nunca vai para o git.
OPENAI_API_KEY=sk-...

# Opcional: bot do Telegram (crie com o @BotFather)
TELEGRAM_BOT_TOKEN=

# Opcional: chave de ADMIN da OpenAI, para ver o custo real em vez da
# estimativa local. É outro tipo de credencial — a chave normal não serve.
# platform.openai.com > Settings > Organization > Admin keys,
# com o escopo api.usage.read.
OPENAI_ADMIN_KEY=
